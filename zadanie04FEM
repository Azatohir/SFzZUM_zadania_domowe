import numpy as np
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation
from matplotlib.patches import Polygon
from numba import njit, prange


@njit(cache=True)
def _compute_element_forces_numba(p0, p1, p2, x_inv, volume, young_modulus, poisson_ratio):
    """Return 3x2 element force matrix for a single triangle using Green-Lagrange strain."""
    forces = np.zeros((3, 2), dtype=np.float64)
    if volume == 0.0:
        return forces

    # Deformation gradient F
    F = np.zeros((2, 2), dtype=np.float64)
    F[:, 0] = p1 - p0
    F[:, 1] = p2 - p0
    F = F @ x_inv

    # Green-Lagrange strain E = 0.5*(F^T F - I)
    E = np.zeros((2,2), dtype=np.float64)
    E[0,0] = 0.5 * (F[0,0]**2 + F[1,0]**2 - 1.0)
    E[1,1] = 0.5 * (F[0,1]**2 + F[1,1]**2 - 1.0)
    E[0,1] = 0.5 * (F[0,0]*F[0,1] + F[1,0]*F[1,1])
    E[1,0] = E[0,1]

    # Plane stress constitutive relation (C matrix)
    c = young_modulus / (1.0 - poisson_ratio**2)
    C = np.zeros((3,3), dtype=np.float64)
    C[0,0] = c
    C[0,1] = c*poisson_ratio
    C[1,0] = c*poisson_ratio
    C[1,1] = c
    C[2,2] = c*(1-poisson_ratio)/2

    e_vec = np.zeros(3, dtype=np.float64)
    e_vec[0] = E[0,0]
    e_vec[1] = E[1,1]
    e_vec[2] = E[0,1]

    s_vec = C @ e_vec
    stress = np.zeros((2,2), dtype=np.float64)
    stress[0,0] = s_vec[0]
    stress[1,1] = s_vec[1]
    stress[0,1] = s_vec[2]
    stress[1,0] = s_vec[2]

    # Shape function gradients
    grad0 = -x_inv[:,0] - x_inv[:,1]
    grad1 = x_inv[:,0]
    grad2 = x_inv[:,1]

    grads = np.zeros((3,2), dtype=np.float64)
    grads[0,:] = grad0
    grads[1,:] = grad1
    grads[2,:] = grad2

    # Compute nodal forces
    for i in range(3):
        forces[i, :] = -volume * (stress @ grads[i])

    return forces




@njit(cache=True, parallel=True)
def _assemble_forces_numba(
    positions,
    tri_indices,
    tri_x_inv,
    tri_volumes,
    masses,
    fixed_mask,
    young_modulus,
    poisson_ratio,
):
    n = positions.shape[0]
    f_global = np.zeros((n, 2), dtype=np.float64)
    for tri_idx in prange(tri_indices.shape[0]):
        vol = tri_volumes[tri_idx]
        if vol == 0.0:
            continue
        idx = tri_indices[tri_idx]
        f_elem = _compute_element_forces_numba(
            positions[idx[0]],
            positions[idx[1]],
            positions[idx[2]],
            tri_x_inv[tri_idx],
            vol,
            young_modulus,
            poisson_ratio,
        )
        for i in range(3):
            f_global[idx[i]] += f_elem[i]

    # Zero out forces for fixed particles
    for i in range(n):
        if fixed_mask[i]:
            f_global[i, 0] = 0.0
            f_global[i, 1] = 0.0

    return f_global


@njit(cache=True, parallel=True)
def _integrate_particles_numba(
    positions,
    velocities,
    masses,
    forces,
    dt,
    damping,
    fixed_mask,
    ground_y,
    collision_coeff
):
    """Semi-implicit Euler (implicit velocity) integration."""
    n = positions.shape[0]
    for i in prange(n):
        if fixed_mask[i]:
            velocities[i] = 0.0
            continue

        inv_mass = 1.0 / masses[i]
        # Update velocity first (semi-implicit)
        velocities[i] = damping * (velocities[i] + forces[i] * inv_mass * dt)
        # Update position
        positions[i] += velocities[i] * dt

        # Ground collision
        if positions[i, 1] < ground_y:
            positions[i, 1] = ground_y
            velocities[i, 1] *= -collision_coeff


class FEMSoftBody:

    def __init__(self, young_modulus=5000, poisson_ratio=0.3,
                 fix_top=True, strain_type='green', gravity=100):
        self.E = young_modulus
        self.nu = poisson_ratio
        self.fix_top = fix_top
        self.strain_type = strain_type
        self.gravity = gravity

        self.particles = []
        self.triangles = []

        self.positions = None
        self.positions0 = None
        self.velocities = None
        self.masses = None
        self.fixed_mask = None

        self.tri_indices_array = None
        self.tri_x_inv_array = None
        self.tri_volume_array = None
        self.last_forces = None
        self.time = 0.0

        self.create_mesh()
        self.precompute_rest_config()

    def create_mesh(self):
        grid_size = 15
        spacing = 0.1
        offset_x = 2.0
        offset_y = 1.0
        ground_y = 2.0

        for j in range(grid_size):
            for i in range(grid_size):
                x = (offset_x + i * spacing) / (spacing * grid_size)
                y = (offset_y + j * spacing) / (spacing * grid_size)
                fixed = (j == 0) and self.fix_top
                self.particles.append({'pos': np.array([x, y]),
                                       'pos0': np.array([x, y]),
                                       'vel': np.zeros(2),
                                       'mass': 1.0,
                                       'fixed': fixed})

        self._initialize_particle_arrays()

        # Center mesh
        centroid = self.positions.mean(axis=0)
        self.positions -= centroid
        self.positions0 -= centroid
        self.positions[:, 1] *= -1
        self.positions0[:, 1] *= -1
        self.ground_y = -(ground_y - centroid[1])

        # Triangles
        self.triangles = []
        for j in range(grid_size - 1):
            for i in range(grid_size - 1):
                idx = j * grid_size + i
                self.triangles.append({'indices': [idx, idx + 1, idx + grid_size]})
                self.triangles.append({'indices': [idx + 1, idx + grid_size + 1, idx + grid_size]})

    def precompute_rest_config(self):
        x_inv_list = []
        vol_list = []
        for tri in self.triangles:
            i0, i1, i2 = tri['indices']
            x0, x1, x2 = self.positions0[[i0, i1, i2]]
            X = np.column_stack([x1 - x0, x2 - x0])
            vol = 0.5 * abs(np.linalg.det(X))
            if vol < 1e-12:
                tri['X_inv'] = np.eye(2)
                tri['volume'] = 0.0
            else:
                tri['X_inv'] = np.linalg.inv(X)
                tri['volume'] = vol
            x_inv_list.append(tri['X_inv'])
            vol_list.append(tri['volume'])

        self.tri_indices_array = np.array([tri['indices'] for tri in self.triangles], dtype=np.int64)
        self.tri_x_inv_array = np.array(x_inv_list, dtype=np.float64)
        self.tri_volume_array = np.array(vol_list, dtype=np.float64)

    def assemble_global_forces(self):
        f_global = _assemble_forces_numba(
            self.positions,
            self.tri_indices_array,
            self.tri_x_inv_array,
            self.tri_volume_array,
            self.masses,
            self.fixed_mask,
            self.E,
            self.nu,
        )

        # Wyłącz grawitację
        # f_global[:, 1] -= self.masses * self.gravity

        # Dodaj stałą siłę rotacyjną do obracania ciała
        positions = self.positions
        center = np.mean(positions, axis=0)
        omega = np.pi  # rad/s, reguluj prędkość obrotu
        for i in range(positions.shape[0]):
            r = positions[i] - center
            if not self.fixed_mask[i]:
                self.velocities[i] = np.array([-omega * r[1], omega * r[0]])

        # Zablokowane cząstki
        for i in range(len(self.fixed_mask)):
            if self.fixed_mask[i]:
                f_global[i] = 0.0

        return f_global

    def update(self, dt):
        self.time += dt
        self.last_forces = self.assemble_global_forces()
        damping = 0.99
        collision_coeff = 0.0
        _integrate_particles_numba(
            self.positions,
            self.velocities,
            self.masses,
            self.last_forces,
            dt,
            damping,
            self.fixed_mask,
            self.ground_y,
            collision_coeff,
        )

    def get_triangle_positions(self):
        return [self.positions[tri['indices']] for tri in self.triangles]

    def get_particle_positions(self):
        return self.positions

    def _initialize_particle_arrays(self):
        self.positions = np.array([p['pos'] for p in self.particles], dtype=np.float64)
        self.positions0 = np.array([p['pos0'] for p in self.particles], dtype=np.float64)
        self.velocities = np.array([p['vel'] for p in self.particles], dtype=np.float64)
        self.masses = np.array([p['mass'] for p in self.particles], dtype=np.float64)
        self.fixed_mask = np.array([p['fixed'] for p in self.particles], dtype=bool)


def main():
    sim = FEMSoftBody(young_modulus=15000, poisson_ratio=0.3, fix_top=False, strain_type='green', gravity=30)

    fig, ax = plt.subplots(figsize=(8, 8))
    ax.set_aspect('equal')
    initial_pos = sim.get_particle_positions()
    x_extent = np.max(np.abs(initial_pos[:, 0])) + 1.0
    y_extent = np.max(np.abs(initial_pos[:, 1])) + 1.0
    ax.set_xlim(-x_extent, x_extent)
    ax.set_ylim(-y_extent, y_extent)
    ax.axhline(y=sim.ground_y, color='k', lw=2)
    ax.set_title("2D FEM Soft Body Simulation (Stable)")

    patches = [Polygon([[0, 0], [0, 0], [0, 0]], fc='lightblue', ec='blue', alpha=0.6)
               for _ in sim.triangles]
    for patch in patches:
        ax.add_patch(patch)

    pts, = ax.plot([], [], 'o', color='darkblue', ms=4)
    fixed_pts, = ax.plot([], [], 'o', color='red', ms=6)
    zero_forces = np.zeros_like(initial_pos)
    force_quiver = ax.quiver(initial_pos[:, 0], initial_pos[:, 1],
                             zero_forces[:, 0], zero_forces[:, 1],
                             color='orange', angles='xy', scale_units='xy', scale=1.0, width=0.003, alpha=0.7)
    txt = ax.text(0.02, 0.95, '', transform=ax.transAxes)
    frame = [0]
    force_scale = 0.003

    def init():
        force_quiver.set_offsets(initial_pos)
        force_quiver.set_UVC(zero_forces[:, 0], zero_forces[:, 1])
        return patches + [pts, fixed_pts, force_quiver, txt]

    def animate(_):
        dt = 0.01
        substeps = 50
        sdt = dt / substeps
        for _ in range(substeps):
            sim.update(sdt)

        tri_pos = sim.get_triangle_positions()
        for patch, verts in zip(patches, tri_pos):
            patch.set_xy(verts)

        pos = sim.get_particle_positions()
        mask = sim.fixed_mask
        pts.set_data(pos[~mask, 0], pos[~mask, 1])
        fixed_pts.set_data(pos[mask, 0], pos[mask, 1])
        forces = sim.last_forces * force_scale
        force_quiver.set_offsets(pos)
        force_quiver.set_UVC(forces[:, 0], forces[:, 1])
        frame[0] += 1
        txt.set_text(f"Frame: {frame[0]}")
        return patches + [pts, fixed_pts, force_quiver, txt]

    anim = FuncAnimation(fig, animate, init_func=init, frames=500, interval=20, blit=True)
    plt.show()


if __name__ == "__main__":
    main()
